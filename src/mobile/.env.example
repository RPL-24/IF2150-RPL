# Salin menjadi `.env` (tidak di-commit). Variabel EXPO_PUBLIC_* ikut ter-bundle ke aplikasi,
# jadi JANGAN isi dengan rahasia server.

# Alamat API. Kosongkan untuk otomatis memakai IP laptop yang menjalankan `expo start` + port 3000.
# Emulator Android: http://10.0.2.2:3000   |   HP fisik: http://<IP-LAN-laptop>:3000
EXPO_PUBLIC_API_URL=

# Opsional: client ID OAuth Google Sign-In (butuh development build; server isi GOOGLE_CLIENT_IDS yang sama)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Opsional, hanya saat build APK / development build (tidak ikut ter-bundle): kunci Google Maps SDK for Android
GOOGLE_MAPS_ANDROID_API_KEY=
