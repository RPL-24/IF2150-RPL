<%- include('../partials/header', { varian: 'polos', judulHalaman: 'Login' }) %>
<div class="sempit">

  <section class="kotak login-panel">
    <form id="form-login" class="login-form" method="POST" action="/login">
      <p class="login-judul">Login Sebagai Masyarakat</p>
      <input id="username" class="isian" type="text" name="email" placeholder="Username" autocomplete="username" required>
      <input class="isian" type="password" name="kataSandi" placeholder="Password" autocomplete="current-password" required>
      <div class="centang">
        <input id="ingat" type="checkbox">
        <label for="ingat">Ingat username</label>
      </div>
      <button type="submit" class="tombol tombol-penuh">Log In</button>
    </form>

    <div class="login-samping">
      <a class="lupa" href="#">Atau</a>
      <p>Kamu bisa menggunakan fitur SearchLaw tanpa login!</p>
      <a class="tombol tombol-garis" href="/pencarian/pasal">Log In Sebagai Tamu</a>
    </div>
  </section>

  <section class="login-bagian">
    <h2>Pertama kali menggunakan LawHub?</h2>
    <p>Kamu perlu login untuk mengakses fitur lengkap LawHub sebagai masyarakat!</p>
    <a class="tombol tombol-garis" href="/registrasi-masyarakat">Registrasi</a>
  </section>

</div>
<script src="/js/login.js"></script>
<%- include('../partials/footer') %>
