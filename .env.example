# Salin ke .env.local lalu isi. JANGAN commit .env.local.

# Supabase: Dashboard → Project Settings → API (URL + publishable key, aman untuk browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (anti-bot form lapor, KNF04). Site key untuk browser, secret key untuk server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Khusus script seed (Fondasi). JANGAN dipakai di kode aplikasi dan JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
