# Generated in the repository root by scripts/setup.sh; never commit real values.
NODE_ENV=production
PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DATABASE_URL=postgres://sisarasa:REPLACE_WITH_GENERATED_SECRET@db:5432/sisarasa
ACCESS_SECRET=REPLACE_WITH_GENERATED_SECRET
CALLBACK_SECRET=REPLACE_WITH_SEPARATE_GENERATED_SECRET
PICKUP_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MEDIA_DIR=/app/uploads
FEE_BPS=500
TRUST_PROXY=loopback
CORS_ORIGINS=
API_HOST_PORT=3100
