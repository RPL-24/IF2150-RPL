<%- include('../partials/header', { varian: 'polos', judulHalaman: 'Registrasi Mitra' }) %>
<div class="sempit">
  <section class="kotak">
    <form class="login-form" method="POST" action="/registrasi-mitra" enctype="multipart/form-data">
      <p class="login-judul">Registrasi Mitra Pengacara</p>

      <h2 class="judul-seksi">Data Akun</h2>
      <input class="isian" type="text" name="nama" placeholder="Nama Lengkap/Nama Firma (sesuai KTP)"
             value="<%= (locals.lama && lama.nama) || '' %>" required>
      <input class="isian" type="email" name="email" placeholder="Email"
             value="<%= (locals.lama && lama.email) || '' %>" required>
      <input class="isian" type="text" name="username" placeholder="Username" autocomplete="username"
             value="<%= (locals.lama && lama.username) || '' %>" required>
      <input class="isian" type="password" name="kataSandi" placeholder="Password (minimal 8 karakter)"
             autocomplete="new-password" minlength="8" required>
      <input class="isian" type="password" name="konfirmasi" placeholder="Tulis ulang password"
             autocomplete="new-password" minlength="8" required>

      <h2 class="judul-seksi">Verifikasi Dokumen</h2>
      <input class="isian" type="text" name="namaFirma" placeholder="Nama Firma *"
             value="<%= (locals.lama && lama.namaFirma) || '' %>" required>

      <label for="ijazah">Ijazah *</label>
      <input id="ijazah" type="file" name="ijazah" accept=".pdf,.jpg,.jpeg,.png" required>
      <label for="kta">KTA *</label>
      <input id="kta" type="file" name="kta" accept=".pdf,.jpg,.jpeg,.png" required>
      <label for="sipa">SIPA *</label>
      <input id="sipa" type="file" name="sipa" accept=".pdf,.jpg,.jpeg,.png" required>
      <label for="bas">BAS *</label>
      <input id="bas" type="file" name="bas" accept=".pdf,.jpg,.jpeg,.png" required>
      <label for="ktp">KTP (opsional)</label>
      <input id="ktp" type="file" name="ktp" accept=".pdf,.jpg,.jpeg,.png">
      <label for="cv">CV (opsional)</label>
      <input id="cv" type="file" name="cv" accept=".pdf,.jpg,.jpeg,.png">
      <p class="bantuan-form">Format PDF/JPG/PNG, maksimal 5 MB per berkas.</p>

      <div class="aksi-form">
        <button type="submit" class="tombol tombol-penuh">Registrasi</button>
      </div>
    </form>
  </section>
</div>
<%- include('../partials/footer') %>