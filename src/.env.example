# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Server
PORT=3000

# Basis data PostgreSQL (dipakai docker-compose.yml dan server)
DB_HOST=localhost
DB_PORT=5432
DB_USER=itbeli
DB_PASSWORD=
DB_NAME=itbeli
# Opsional: isi untuk memakai basis data lain (misalnya Supabase). Jika diisi, DB_* di atas diabaikan.
DATABASE_URL=

# Surel (SMTP). Bawaan diarahkan ke Mailpit dari docker-compose.yml,
# kotak masuknya dapat dilihat di http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SUREL_PENGIRIM=ITBELI <no-reply@itbeli.local>

# Keamanan
BCRYPT_SALT_ROUNDS=10
DURASI_SESI_JAM=24
DURASI_KODE_MENIT=15
