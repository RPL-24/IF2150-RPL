# Salin ke .env.local lalu isi. JANGAN commit .env.local.

# Supabase: Dashboard → Project Settings → API (URL + publishable key, aman untuk browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (anti-bot form lapor, KNF04). Site key untuk browser, secret key untuk server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Khusus script seed (Fondasi). JANGAN dipakai di kode aplikasi dan JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Khusus uji integrasi (npm run test:integration, menembak production). Akun tes per peran, BUKAN akun asli.
# Juga butuh SUPABASE_SECRET_KEY di atas (client service role untuk setup + bersih-bersih).
TEST_INT_WARGA_EMAIL=warga-tes@contoh.test
TEST_INT_ADMIN_EMAIL=admin-tes@contoh.test
TEST_INT_EKSEKUTOR_EMAIL=eksekutor-tes@contoh.test
TEST_INT_PASSWORD=isi-password-akun-tes
