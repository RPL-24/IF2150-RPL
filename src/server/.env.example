# Salin menjadi `.env` (file .env tidak boleh di-commit).
PORT=3000

# PostgreSQL dari docker-compose.yml
DATABASE_URL=postgres://silembur:silembur@localhost:5432/silembur
TEST_DATABASE_URL=postgres://silembur:silembur@localhost:5432/silembur_test

# Wajib diganti dengan string acak panjang di luar lingkungan lokal
JWT_SECRET=ganti-dengan-string-acak
JWT_EXPIRES_IN=7d

# Penyimpanan foto: "local" (default, folder UPLOAD_DIR) atau "gcs" (Google Cloud Storage)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Kosongkan untuk memakai fallback offline (wilayah = kecamatan terdekat)
GOOGLE_MAPS_API_KEY=

# Client ID OAuth Google Sign-In, dipisah koma (web,android,ios). Kosong = login Google nonaktif
GOOGLE_CLIENT_IDS=
