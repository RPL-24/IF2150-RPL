# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Opsi 1: Gunakan Connection URI penuh (mis. Supabase / Neon / Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahasehat_db

# Opsi 2: Konfigurasi terpisah jika DATABASE_URL tidak diisi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mahasehat_db
DB_USER=postgres
DB_PASSWORD=postgres

# Security & Encryption (KNF01 - AES-256 & JWT)
JWT_SECRET=isi_dengan_teks_acak_minimal_32_karakter
JWT_EXPIRES_IN=24h
# Kunci AES-256 wajib 32 karakter (256-bit) untuk enkripsi catatan jurnal & riwayat kesehatan
AES_SECRET_KEY=isi_dengan_teks_acak_32_karakter

# SMTP / Mail Service Configuration (Nodemailer - Konfirmasi Wali & Notifikasi Darurat)
# Biarkan SMTP_HOST kosong untuk uji lokal: isi e-mail, termasuk tautan, dicetak ke log server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MahaSehat Support <no-reply@mahasehat.id>"

# External APIs (Opsional - jika kosong sistem menggunakan Haversine Formula bawaan)
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_API_KEY=

# Jadwal evaluasi notifikasi darurat harian (UC08), zona waktu Asia/Jakarta
EMERGENCY_CRON=0 8 * * *

