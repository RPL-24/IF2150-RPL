{
  "expo": {
    "name": "SILEMBUR",
    "slug": "silembur",
    "scheme": "silembur",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.silembur.app"
    },
    "android": {
      "package": "id.silembur.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SILEMBUR memakai lokasi Anda untuk menandai titik kerusakan fasilitas pada laporan."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SILEMBUR membutuhkan akses galeri untuk melampirkan foto kerusakan.",
          "cameraPermission": "SILEMBUR membutuhkan kamera untuk memotret kerusakan fasilitas."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": { "usesCleartextTraffic": true, "enableMinifyInReleaseBuilds": false }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0a344add-5c0c-4eff-a560-7841342bbd91"
      }
    },
    "owner": "laksamada"
  }
}
